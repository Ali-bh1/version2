# ── Database ──────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/tejal_desae

# ── Server ────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── JWT ───────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_EXPIRY=8h

# ── CSRF ─────────────────────────────────────────
CSRF_SECRET=REPLACE_WITH_RANDOM_SECRET

# ── CORS ─────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5500,https://tejaldesae.com

# ── Admin ─────────────────────────────────────────
# Set these to bootstrap the first admin account
ADMIN_EMAIL=admin@tejaldesae.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Gmail Lead Notifications ─────────────────────
# Sends email to hello@tejaldesae.com on every new lead.
# Use a Gmail App Password (NOT your regular password).
# 1. Enable 2FA on your Google account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App Password for "Mail" → copy the 16-char code
GMAIL_USER=hello@tejaldesae.com
GMAIL_APP_PASSWORD=REPLACE_WITH_16_CHAR_APP_PASSWORD
LEAD_NOTIFY_EMAIL=hello@tejaldesae.com
