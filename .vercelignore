# ── Magic-link backend: built, but not in use ──
# Nothing on the site calls /api any more — the assessment is open to
# anyone and the report reads the visitor's own localStorage. Excluded so
# Vercel keeps this a pure static deploy instead of building dead
# functions. Delete api/ and package.json outright if you never want it.
api/
package.json
.env.example

# ── Backend: never upload to the static host ──
# server/.env holds DB + CSRF secrets. This must stay excluded.
server/
node_modules/
.env
*.env

